GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# Optional official OpenAI provider. Prefer the Gradio request-only password field.
# Create a project key with a maximum seven-day expiration; never commit it here.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
LLM_PROVIDER="openai"

# Optional advisory A/B judge. Leave blank to keep every A/B action offline.
JUDGE_PROVIDER="gemini"
JUDGE_BASE_URL=""
JUDGE_MODEL=""

# Docker Compose binds locally by default. Use 0.0.0.0 only behind an
# appropriate firewall/security group.
BIND_ADDRESS="127.0.0.1"
API_PORT="8000"
DASHBOARD_PORT="8501"
GRADIO_PORT="7860"

# Shared quality profile. Keep these values unchanged between local and AWS.
OCR_LANGUAGES="por+eng"
OCR_DPI="300"
OCR_TIMEOUT_SECONDS="900"
OCR_IMAGE_MIN_DIMENSION="1800"
OCR_IMAGE_MAX_PIXELS="24000000"
OCR_IMAGE_MAX_SCALE="3.0"
OMP_THREAD_LIMIT="2"
TORCH_EMBEDDING_DEVICE="cpu"
